{
  "Auth": {
    "AdminPassword": "${AUTH_ADMIN_PASSWORD}"
  },
  "Cors": {
    "AllowedOrigins": [
      "${CORS_ALLOWED_ORIGINS}"
    ]
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "booked",
    "Audience": "booked_clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "RateLimit": {
    "Enabled": true,
    "RegistrationLimit": 5,
    "RegistrationLimitMinutes": 15,
    "LoginLimit": 5,
    "LoginLimitMinutes": 15,
    "RefreshLimit": 10,
    "RefreshLimitMinutes": 1,
    "HttpStatusCode": 429,
    "LogViolations": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
