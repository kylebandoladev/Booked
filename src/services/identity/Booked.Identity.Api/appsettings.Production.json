{
  "Auth": {
    "AdminPassword": "${AUTH_ADMIN_PASSWORD}"
  },
  "Cors": {
    "AllowedOrigins": [
      "${CORS_ALLOWED_ORIGINS}"
    ]
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "booked",
    "Audience": "booked_clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
